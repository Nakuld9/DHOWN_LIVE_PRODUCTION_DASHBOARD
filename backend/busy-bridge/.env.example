# ---------------------------------------------------------------------------
# BUSY BRIDGE — add these to backend/.env
#
# SECURITY: this file is a TEMPLATE. Never commit a filled-in .env.
# BUSY credentials must never reach the React frontend. No API route returns
# them — the BUSY Bridge page only ever sees redactedConfig().
# ---------------------------------------------------------------------------

# Set to false to mount the routes but never touch BUSY (useful while the
# Section 6 site checklist in docs/BUSY_INTEGRATION.md is still open).
BUSY_BRIDGE_ENABLED=true

# Which BUSY transport to use. See docs/BUSY_INTEGRATION.md.
#   xml    - BUSY XML Data Export/Import over the shared folder (default)
#   rest   - third-party REST gateway, ONLY if one has been licensed
#   memory - in-process fake, development only; refused when NODE_ENV=production
BUSY_ADAPTER=xml

# --- XML file exchange ------------------------------------------------------
# BUSY runs on a DIFFERENT PC, so these are normally UNC paths to a share on
# that machine (or a mapped drive). Fill in from checklist section 6.3.
#   BUSY_XML_OUTBOX=\\BUSY-PC\BusyExchange\Outbox
#   BUSY_XML_ACK=\\BUSY-PC\BusyExchange\Ack
#   BUSY_XML_INBOX=\\BUSY-PC\BusyExchange\Inbox
#   BUSY_XML_ARCHIVE=\\BUSY-PC\BusyExchange\Archive
BUSY_XML_OUTBOX=./busy-exchange/outbox
BUSY_XML_ACK=./busy-exchange/ack
BUSY_XML_INBOX=./busy-exchange/inbox
BUSY_XML_ARCHIVE=./busy-exchange/archive

# The company name as it appears in BUSY, and a label for the BUSY PC shown
# on the dashboard when the share cannot be reached.
BUSY_COMPANY_NAME=DHOWN
BUSY_HOST_LABEL=BUSY-PC

# --- REST gateway (only when BUSY_ADAPTER=rest) -----------------------------
BUSY_REST_BASE_URL=
BUSY_REST_API_KEY=
BUSY_REST_TIMEOUT_MS=15000
# true when the gateway only reads BUSY's SQL database. Writes are then
# refused outright — see the audit decision in docs/BUSY_INTEGRATION.md.
BUSY_REST_READ_ONLY=false

# --- Queue / retry ----------------------------------------------------------
BUSY_QUEUE_POLL_INTERVAL_MS=10000
BUSY_QUEUE_BATCH_SIZE=10
# Attempts before a transaction is parked in MANUAL_REVIEW. Never retries forever.
BUSY_MAX_ATTEMPTS=4
BUSY_RETRY_BASE_DELAY_MS=30000
BUSY_RETRY_MAX_DELAY_MS=3600000

# --- Which transactions flow to BUSY ---------------------------------------
# Comma-separated. Anything omitted is refused at the API boundary.
BUSY_ENABLED_ENTITY_TYPES=CUSTOMER,VENDOR,ITEM,SALES_REFERENCE,PURCHASE_REFERENCE,DISPATCH,INVOICE

# --- Reconciliation ---------------------------------------------------------
BUSY_RECONCILE_INTERVAL_MS=900000
BUSY_RECONCILE_LOOKBACK_DAYS=7
